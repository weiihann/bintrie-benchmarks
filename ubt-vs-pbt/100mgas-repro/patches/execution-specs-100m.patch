+# Touches-per-block CAPACITY (sequence length). Env-driven so the campaign can
+# scale it: a 16 M-gas tx fit ~700 touches; a 100 M-gas tx (per-tx cap bypassed)
+# fits ~4.4 k, so set T_TOUCHES with headroom above the gas-bound touch count.
+# Each touch is ~22 k gas (cold CALL + cold SLOAD/SSTORE + getter framing).
+T_TOUCHES = int(os.environ.get("T_TOUCHES", "700"))
+
+
+# Memory layout — derived from T_TOUCHES so the address TABLE (up to T_TOUCHES
+# addresses, since max K = T_TOUCHES) and the T_TOUCHES-pair SEQUENCE never
+# collide. Region starts are 4 KB-aligned.
+def _align4k(x: int) -> int:
+    return (x + 0xFFF) & ~0xFFF
+
+
+TABLE = 0                                      # up to T_TOUCHES addresses, 32 B each
+SEQUENCE = _align4k(32 * T_TOUCHES) or 0x1000  # T_TOUCHES pairs, 32 B each
+SCRATCH = _align4k(SEQUENCE + 32 * T_TOUCHES)
 ARG_SLOT = SCRATCH          # getter calldata word 0
 ARG_VALUE = SCRATCH + 32    # getter calldata word 1
 ARG_ISWRITE = SCRATCH + 64  # getter calldata word 2
