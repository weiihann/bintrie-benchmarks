# Source this before any build/run step. Routes everything onto /home (nvme),
# away from the nearly-full / and the RAM-backed /tmp (tmpfs).
export WORK=/home/ethereum/work
export GOPATH=$WORK/go/path
export GOCACHE=$WORK/go/cache
export GOMODCACHE=$WORK/go/modcache
export TMPDIR=$WORK/tmp
export GOTMPDIR=$WORK/tmp
# Toolchain Go (installed under $WORK/toolchain/go) takes precedence over system 1.21.6
export PATH=$WORK/toolchain/go/bin:$GOPATH/bin:$HOME/.local/bin:$PATH

# Campaign binaries (built for arm64)
export BENCH_BINS=$WORK/bench-bins
export GETH_UBT_BIN=$BENCH_BINS/geth-ubt
export GETH_PBT_BIN=$BENCH_BINS/geth-pbt
export STATE_ACTOR_UBT_BIN=$BENCH_BINS/state-actor-ubt
export STATE_ACTOR_PBT_BIN=$BENCH_BINS/state-actor-pbt
export SPAMOOR_BIN=$BENCH_BINS/spamoor

# Sources + harness
export EXEC_SPECS=$WORK/repos/execution-specs
export DB_BASE=$WORK/dbs
